# Data source: s3 | local (auto-detects from AMS_S3_BUCKET / AMS_LOCAL_DIR when unset)
AMS_DATA_SOURCE=s3

# S3 — same env vars as the AMS Python SDK
AMS_S3_BUCKET=your-bucket
AMS_S3_PREFIX=ams
AMS_S3_REGION=us-east-1
# AMS_S3_ENDPOINT_URL=https://...   # R2, MinIO, etc.

# Local filesystem (same layout as S3) — alternative to S3
# AMS_DATA_SOURCE=local
# AMS_LOCAL_DIR=dashboard/fixtures/mock-ams-data

# Standard AWS credentials (pick one):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=...

# Server-side TTL (seconds) for assembled reads, so the per-request S3 fan-out
# (one GET per session index / facet member) is paid once per window and shared
# across requests. Default 30; set 0 to disable caching.
# AMS_CACHE_TTL_SECONDS=30
